{
  "name": "studyup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Projeto escolar StudyUp",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --watch --env-file-if-exists=.env backend/server.js",
    "test": "node --test backend/tests/*.test.js",
    "db:check": "node --env-file-if-exists=.env backend/scripts/check-database.js",
    "db:setup": "node backend/scripts/setup-database.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "mysql2": "3.24.6"
  }
}
