# Configuração local. Copie para env/.env; nunca sobrescreva uma configuração existente.
# Restrinja env/ a 0700 e env/.env a 0600. Não coloque credenciais neste exemplo.
HOST=127.0.0.1
PORT=3000
# Descomente e preencha depois de criar o banco e o usuário de aplicação.
# Não use o usuário administrador/root na aplicação.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=studyup
# DB_USER=studyup_app
# DB_PASSWORD=preencha_localmente
